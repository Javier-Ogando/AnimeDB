# Copia este archivo a .env y rellena los valores de tu proyecto Firebase.
# Los encuentras en: Consola de Firebase > Configuracion del proyecto > General > Tus apps.
# Solo las variables con prefijo VITE_ llegan al cliente.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UIDs con acceso al panel de administración (/estado), separados por comas.
# Se ve en la consola de Firebase > Authentication > Users.
VITE_ADMIN_UIDS=
